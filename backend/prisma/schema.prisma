// =====================================================================
// Canoa Club — schema dati (bozza v0.1)
// Identificatori in inglese, documentazione in italiano.
// Importi monetari: Decimal(10,2), mai Float.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUM
// ---------------------------------------------------------------------

/// Ruoli RBAC
enum Role {
  ADMIN       // Amministratore: accesso completo
  INSTRUCTOR  // Istruttore: gestisce le uscite di club
  MEMBER      // Socio: catalogo, prenotazioni personali, storico
}

/// Categorie di attrezzatura gestite
enum EquipmentCategory {
  CANOE        // Canoe
  PADDLE       // Pagaie
  HELMET       // Caschi
  WATER_JACKET // Giacche d'acqua
  SPRAY_DECK   // Paraspruzzi
  WETSUIT      // Mute
  LIFE_JACKET  // Salvagenti
}

/// Stato attuale del singolo pezzo
enum ItemStatus {
  AVAILABLE // Disponibile
  RENTED    // In Noleggio
}

/// Servizi legati al furgone (voci di listino non attrezzatura)
enum ServiceType {
  EQUIPMENT_TRANSPORT // (2) Solo trasporto attrezzatura sul furgone
  VAN_SEAT            // (3) Quota utilizzo furgone per chi viaggia a bordo
}

/// Modalità di viaggio del socio in un'uscita (Passo 2 del wizard).
/// Codifica a livello di dato l'esclusività mutua tra opzione (2) e (3):
/// un partecipante ha UNA sola modalità.
enum TravelMode {
  VAN            // A) A bordo del furgone → quota furgone + spese vive
  TRANSPORT_ONLY // B) Mezzo proprio, attrezzatura sul furgone → tariffa trasporto
  AUTONOMOUS     // C) Autonomo → nessun costo furgone
}

/// Un'uscita resta sempre modificabile finché non viene annullata.
/// Programmata / in corso / conclusa si ricava dalle date, non è uno stato salvato.
enum OutingStatus {
  ACTIVE
  CANCELLED
}

enum RentalKind {
  PERSONAL // prenotazione autonoma del socio
  OUTING   // noleggio dentro un'uscita di club
}

enum RentalStatus {
  RESERVED  // prenotato, non ancora ritirato
  ACTIVE    // materiale consegnato
  RETURNED  // materiale rientrato
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID // incasso confermato
}

// ---------------------------------------------------------------------
// UTENTI
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rentals             Rental[]            @relation("RentalMember")
  outingsLed          Outing[]            @relation("OutingInstructor")
  participations      OutingParticipant[]
  paymentsConfirmed   OutingParticipant[] @relation("PaymentConfirmedBy")
  rentalOptionUpdates RentalOption[]
  serviceFeeUpdates   ServiceFee[]

  @@index([role])
}

// ---------------------------------------------------------------------
// INVENTARIO
// ---------------------------------------------------------------------

model EquipmentItem {
  id           String            @id @default(cuid())
  category     EquipmentCategory
  brand        String
  model        String
  /// Taglia (es. "M", "XL") o volume (es. "250 L") a seconda della categoria
  size         String?
  /// Numero di serie univoco: obbligatorio per OGNI pezzo
  serialNumber String            @unique
  description  String?
  status       ItemStatus        @default(AVAILABLE)
  /// Archiviazione logica (dismesso) senza perdere lo storico noleggi
  isArchived   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  /// Foto caricata dall'amministratore; l'API la espone come `photoUrl`
  photo       EquipmentPhoto?
  rentalItems RentalItem[]

  @@index([category, status])
}

/// Immagine del pezzo salvata nel database: Render free non ha un disco persistente.
/// Tabella separata così gli elenchi dell'inventario non caricano i byte delle foto.
model EquipmentPhoto {
  itemId    String        @id
  item      EquipmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data      Bytes
  /// image/jpeg | image/png | image/webp
  mimeType  String
  updatedAt DateTime      @updatedAt
}

// ---------------------------------------------------------------------
// LISTINO PREZZI (gestito dall'Amministratore)
// ---------------------------------------------------------------------

/// Voce del listino noleggi, a prezzo giornaliero uguale per tutti.
/// Es. "Pacchetto Kayak" = CANOE + PADDLE + SPRAY_DECK + LIFE_JACKET + HELMET → 15 €/giorno.
/// Una categoria appartiene al massimo a una voce (verificato dall'API): un noleggio paga
/// ogni voce di cui contiene almeno un pezzo, per il numero di giorni.
/// I noleggi copiano nome e prezzo in RentalCharge, quindi modificare il listino non altera lo storico.
model RentalOption {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  categories  EquipmentCategory[]
  dailyPrice  Decimal             @db.Decimal(10, 2)
  /// Ordine di visualizzazione nel listino
  sortOrder   Int                 @default(0)
  updatedById String?
  updatedBy   User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  charges RentalCharge[]
}

/// Tariffe dei servizi furgone nelle uscite, una per tipo, a importo fisso per uscita.
/// VAN_SEAT = quota furgone (opzione A, 5 €), EQUIPMENT_TRANSPORT = solo trasporto (opzione B, 5 €).
/// Ogni partecipante copia l'importo applicato (transportAmount / vanSeatAmount),
/// quindi modificare la tariffa non altera le quote già calcolate.
model ServiceFee {
  id          String      @id @default(cuid())
  type        ServiceType @unique
  amount      Decimal     @db.Decimal(10, 2)
  updatedById String?
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---------------------------------------------------------------------
// NOLEGGI (personali e di uscita)
// ---------------------------------------------------------------------

/// Un noleggio raggruppa uno o più pezzi per un socio in un intervallo di giorni.
/// - PERSONAL: creato dal socio (prenotazione autonoma)
/// - OUTING:   creato dall'istruttore nel Passo 1 del wizard
/// I giorni sono di calendario e inclusivi: dal 4 al 5 = 2 giorni.
/// Un pezzo non può stare in due noleggi RESERVED/ACTIVE con giorni sovrapposti
/// (verificato dall'API dentro una transazione con lock sui pezzi).
model Rental {
  id        String       @id @default(cuid())
  kind      RentalKind
  status    RentalStatus @default(RESERVED)
  memberId  String
  member    User         @relation("RentalMember", fields: [memberId], references: [id])
  startDate DateTime     @db.Date
  /// Ultimo giorno di noleggio (incluso)
  endDate   DateTime     @db.Date
  /// Totale calcolato (somma delle voci addebitate), congelato alla conferma
  total     Decimal      @default(0) @db.Decimal(10, 2)
  notes     String?

  /// Valorizzato solo per kind = OUTING
  participantId String?            @unique
  participant   OutingParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  items     RentalItem[]
  charges   RentalCharge[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([memberId, startDate])
  @@index([status, startDate, endDate])
}

/// Singolo pezzo assegnato a un noleggio, con il suo rientro.
/// Il prezzo non è per pezzo ma per voce di listino: vedi RentalCharge.
model RentalItem {
  id         String        @id @default(cuid())
  rentalId   String
  rental     Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  itemId     String
  item       EquipmentItem @relation(fields: [itemId], references: [id])
  returnedAt DateTime?
  returnNote String?       // es. danni riscontrati al rientro

  @@unique([rentalId, itemId])
  @@index([itemId])
}

/// Voce di listino addebitata in un noleggio (es. "Pacchetto Kayak · 2 giorni · 30 €").
/// Nome e prezzo sono copiati al momento del calcolo, così restano anche se il listino cambia.
model RentalCharge {
  id         String        @id @default(cuid())
  rentalId   String
  rental     Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  optionId   String?
  option     RentalOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  name       String
  dailyPrice Decimal       @db.Decimal(10, 2)
  days       Int
  amount     Decimal       @db.Decimal(10, 2)

  @@index([rentalId])
}

// ---------------------------------------------------------------------
// USCITE DI CLUB
// ---------------------------------------------------------------------

/// Uscita di club. Giorni di calendario inclusivi, come i noleggi: i noleggi dei
/// partecipanti (kind = OUTING) hanno le stesse date dell'uscita.
model Outing {
  id           String       @id @default(cuid())
  title        String
  destination  String?
  startDate    DateTime     @db.Date
  /// Ultimo giorno dell'uscita (incluso)
  endDate      DateTime     @db.Date
  status       OutingStatus @default(ACTIVE)
  instructorId String
  instructor   User         @relation("OutingInstructor", fields: [instructorId], references: [id])

  /// Posti disponibili sul furgone (null = nessun furgone)
  vanSeats     Int?
  /// Spese vive effettive da ripartire tra chi è a bordo (TravelMode.VAN).
  /// Non ancora usate: quota furgone e spese vive sono rimandate.
  fuelCost     Decimal      @default(0) @db.Decimal(10, 2)
  tollCost     Decimal      @default(0) @db.Decimal(10, 2)

  notes        String?
  participants OutingParticipant[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([startDate])
  @@index([instructorId])
}

/// Riga di partecipazione socio ↔ uscita, prodotta dal wizard.
/// Il noleggio (opzione 1) è la relazione opzionale `rental`;
/// trasporto/furgone (opzioni 2/3) è il singolo campo `travelMode`.
model OutingParticipant {
  id         String     @id @default(cuid())
  outingId   String
  outing     Outing     @relation(fields: [outingId], references: [id], onDelete: Cascade)
  memberId   String
  member     User       @relation(fields: [memberId], references: [id])
  travelMode TravelMode @default(AUTONOMOUS)

  rental     Rental?

  // Dettaglio quota individuale (snapshot ricalcolato fino alla chiusura)
  rentalAmount    Decimal @default(0) @db.Decimal(10, 2) // (1)
  transportAmount Decimal @default(0) @db.Decimal(10, 2) // (2)
  vanSeatAmount   Decimal @default(0) @db.Decimal(10, 2) // (3) quota furgone
  expensesShare   Decimal @default(0) @db.Decimal(10, 2) // (3) quota spese vive
  totalAmount     Decimal @default(0) @db.Decimal(10, 2)

  paymentStatus    PaymentStatus @default(PENDING)
  paidAt           DateTime?
  paidConfirmedById String?
  paidConfirmedBy   User?        @relation("PaymentConfirmedBy", fields: [paidConfirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outingId, memberId]) // un socio una sola volta per uscita
  @@index([memberId])
}

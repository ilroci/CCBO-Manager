PORT=3000
DATABASE_URL="postgresql://user:pass@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"
FRONTEND_URL="https://tuo-frontend.onrender.com"
# Almeno 32 caratteri casuali, es.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambia-questo-valore-con-una-stringa-casuale-lunga"
JWT_EXPIRES_IN="8h"

# Sezione Consigli: i messaggi del form arrivano a SUGGESTIONS_TO.
# Senza SMTP_HOST o SUGGESTIONS_TO il form compare disattivato.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Canoa Club <indirizzo-mittente@example.com>"
SUGGESTIONS_TO="direttivo@example.com"
